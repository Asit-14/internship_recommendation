{
  "Auth": [
    {
      "name": "Register Student",
      "method": "POST",
      "endpoint": "/auth/signup",
      "description": "Register a new student user",
      "request": {
        "body": {
          "name": "John Doe",
          "email": "student@example.com",
          "password": "securepassword"
        }
      },
      "response": {
        "success": {
          "id": 1,
          "name": "John Doe",
          "email": "student@example.com",
          "role": "student"
        },
        "error": {
          "message": "Email already registered"
        }
      },
      "auth_required": false,
      "role": []
    },
    {
      "name": "Register Company",
      "method": "POST",
      "endpoint": "/auth/register-company",
      "description": "Register a new company user",
      "request": {
        "body": {
          "name": "Tech Corp",
          "email": "hr@techcorp.com",
          "password": "securepassword"
        }
      },
      "response": {
        "success": {
          "id": 2,
          "name": "Tech Corp",
          "email": "hr@techcorp.com",
          "role": "company"
        },
        "error": {
          "message": "Email already registered"
        }
      },
      "auth_required": false,
      "role": []
    },
    {
      "name": "Login User",
      "method": "POST",
      "endpoint": "/auth/login",
      "description": "Authenticate user and return token",
      "request": {
        "body": {
          "email": "student@example.com",
          "password": "securepassword"
        }
      },
      "response": {
        "success": {
          "access_token": "eyJhbGciOiJIUzI1...",
          "token_type": "bearer",
          "user": {
            "id": 1,
            "email": "student@example.com",
            "role": "student"
          }
        },
        "error": {
          "message": "Invalid credentials"
        }
      },
      "auth_required": false,
      "role": []
    }
  ],
